<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />

  <!-- ── Performance: DNS prefetch / preconnect ───────────────────────────── -->
  <link rel="dns-prefetch" href="//fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonte premium -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- ── Performance: evita FOUC ─────────────────────────────────────────── -->
  <meta name="color-scheme" content="dark" />

  <!-- ── Viewport ────────────────────────────────────────────────────────── -->
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0, viewport-fit=cover,
                 maximum-scale=1.0, user-scalable=no" />

  <title>Ceará Planejados</title>

  <!-- ── PWA ─────────────────────────────────────────────────────────────── -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0E0E1A" />
  <meta name="msapplication-navbutton-color" content="#0E0E1A" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Ceará" />

  <!-- ── Ícones iOS ───────────────────────────────────────────────────────── -->
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152x152.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192x192.png" />

  <!-- ── Splash iOS ───────────────────────────────────────────────────────── -->
  <link rel="apple-touch-startup-image" href="/splash/splash-750x1334.png"
        media="(device-width:375px) and (device-height:667px) and (-webkit-device-pixel-ratio:2)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1170x2532.png"
        media="(device-width:390px) and (device-height:844px) and (-webkit-device-pixel-ratio:3)" />
  <link rel="apple-touch-startup-image" href="/splash/splash-1290x2796.png"
        media="(device-width:430px) and (device-height:932px) and (-webkit-device-pixel-ratio:3)" />

  <!-- ── Favicons ─────────────────────────────────────────────────────────── -->
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />

  <!-- ── SEO ──────────────────────────────────────────────────────────────── -->
  <meta name="description" content="Sistema de orçamento para vidraçaria e marcenaria — Ceará Planejados" />
  <meta name="robots" content="noindex" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="mobile-web-app-capable" content="yes" />

  <!-- ── Base + Splash Premium ────────────────────────────────────────────── -->
  <style>
    /* GPU hints */
    #nav { will-change: transform; transform: translateZ(0); }
    #hdr { will-change: transform; transform: translateZ(0); }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      background: #0E0E1A;
      overflow: hidden;
      overscroll-behavior: none;
      -webkit-overflow-scrolling: touch;
    }

    /* Sem seleção de texto acidental (app nativo) */
    body { user-select: none; -webkit-user-select: none; }
    input, textarea { user-select: text; -webkit-user-select: text; }

    #root {
      height: 100%;
      padding-top:    env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
      padding-left:   env(safe-area-inset-left);
      padding-right:  env(safe-area-inset-right);
    }

    /* ──── SPLASH SCREEN PREMIUM ──────────────────────────────────────────── */
    #splash {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background:
        radial-gradient(ellipse 80% 60% at 50% 35%, rgba(212,175,55,0.07) 0%, transparent 65%),
        radial-gradient(ellipse 100% 70% at 50% 100%, rgba(20,10,50,0.7) 0%, transparent 55%),
        #0E0E1A;
    }

    #splash.hiding {
      animation: splashOut .42s cubic-bezier(.4,0,.6,1) forwards;
      pointer-events: none;
    }
    #splash.hidden { display: none; }

    @keyframes splashOut {
      0%   { opacity: 1; transform: scale(1);    filter: blur(0); }
      100% { opacity: 0; transform: scale(1.05); filter: blur(5px); }
    }

    /* Halo de luz por trás do ícone */
    .sp-halo {
      position: absolute;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(212,175,55,0.13) 0%, transparent 70%);
      animation: spHalo 2.6s ease-in-out infinite;
    }
    @keyframes spHalo {
      0%,100% { transform: scale(1);   opacity:.5; }
      50%     { transform: scale(1.3); opacity:1;  }
    }

    /* Ícone */
    .sp-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; }

    .sp-icon {
      position: relative; z-index: 1;
      width: 104px; height: 104px;
      border-radius: 26px;
      background: linear-gradient(145deg, #1E1E30, #14141F);
      border: 1.5px solid rgba(212,175,55,0.45);
      display: flex; align-items: center; justify-content: center;
      font-size: 3.5rem;
      box-shadow:
        0 0 0 1px rgba(212,175,55,0.08),
        0 0 50px rgba(212,175,55,0.14),
        0 12px 40px rgba(0,0,0,0.75),
        inset 0 1px 0 rgba(255,255,255,0.06);
      animation: spPop .6s cubic-bezier(.34,1.56,.64,1) both;
      overflow: hidden;
    }
    .sp-icon::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 25%, rgba(212,175,55,0.18) 50%, transparent 75%);
      animation: spShimmer 2.2s .7s ease-in-out infinite;
    }

    @keyframes spPop {
      from { transform: scale(.45); opacity: 0; filter: blur(8px); }
      to   { transform: scale(1);   opacity: 1; filter: blur(0); }
    }
    @keyframes spShimmer {
      from { transform: translateX(-110%); }
      to   { transform: translateX(110%);  }
    }

    /* Textos */
    .sp-name {
      font-family: 'Outfit', -apple-system, sans-serif;
      font-size: 1.65rem; font-weight: 700;
      color: #EDEAE0; letter-spacing: .025em;
      animation: spUp .5s .28s ease both;
    }
    .sp-sub {
      font-family: 'Outfit', -apple-system, sans-serif;
      font-size: .7rem;
      color: rgba(212,175,55,0.55);
      letter-spacing: .18em; text-transform: uppercase;
      margin-top: .45rem;
      animation: spUp .5s .4s ease both;
    }
    @keyframes spUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Progresso */
    .sp-prog-wrap {
      margin-top: 3.2rem;
      width: 52px; height: 2px;
      border-radius: 2px;
      background: rgba(255,255,255,0.05);
      overflow: hidden;
      animation: spUp .4s .52s ease both;
    }
    .sp-prog-bar {
      height: 100%; width: 0%;
      border-radius: 2px;
      background: linear-gradient(90deg, #B8922A, #EDD060, #B8922A);
      background-size: 200% 100%;
      animation:
        spLoad 1.05s .58s cubic-bezier(.4,0,.2,1) forwards,
        spProgShimmer 1.4s .9s linear infinite;
    }
    @keyframes spLoad {
      0%   { width: 0%;   }
      60%  { width: 78%;  }
      100% { width: 100%; }
    }
    @keyframes spProgShimmer {
      from { background-position: 200% 0; }
      to   { background-position: -200% 0; }
    }

    /* Versão */
    .sp-version {
      position: absolute;
      bottom: max(env(safe-area-inset-bottom, 0px), 22px);
      font-family: -apple-system, sans-serif;
      font-size: .6rem;
      color: rgba(255,255,255,0.1);
      letter-spacing: .1em;
      animation: spUp .4s .75s ease both;
    }
  </style>
</head>
<body>

  <!-- ── Splash Screen ────────────────────────────────────────────────────── -->
  <div id="splash" aria-hidden="true">
    <div class="sp-halo"></div>
    <div class="sp-icon-wrap">
      <div class="sp-icon">🪨</div>
    </div>
    <div class="sp-name">Ceará Planejados</div>
    <div class="sp-sub">Vidraçaria · Marcenaria</div>
    <div class="sp-prog-wrap">
      <div class="sp-prog-bar"></div>
    </div>
    <div class="sp-version">v8.0</div>
  </div>

  <!-- ── Mount React ──────────────────────────────────────────────────────── -->
  <div id="root"></div>
  <script type="module" src="/src/main.jsx"></script>

  <!-- ── SW + Splash control ──────────────────────────────────────────────── -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/service-worker.js', { scope: '/' })
          .then(reg => {
            reg.addEventListener('updatefound', () => {
              const nw = reg.installing;
              nw.addEventListener('statechange', () => {
                if (nw.state === 'installed' && navigator.serviceWorker.controller)
                  window.dispatchEvent(new CustomEvent('pwa-update-available'));
              });
            });
          })
          .catch(err => console.warn('[PWA] SW fail:', err));
      });
    }

    const splash  = document.getElementById('splash');
    const root    = document.getElementById('root');
    const MIN_MS  = 920;
    const t0      = Date.now();

    function hideSplash() {
      const wait = Math.max(0, MIN_MS - (Date.now() - t0));
      setTimeout(() => {
        splash.classList.add('hiding');
        const done = () => splash.classList.add('hidden');
        splash.addEventListener('animationend', done, { once: true });
        setTimeout(done, 500); // fallback
      }, wait);
    }

    const obs = new MutationObserver(() => {
      if (root.children.length > 0) { obs.disconnect(); hideSplash(); }
    });
    obs.observe(root, { childList: true });
    setTimeout(() => { obs.disconnect(); hideSplash(); }, 3000);
  </script>

</body>
</html>
